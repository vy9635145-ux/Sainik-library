PORT=3000
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE
# Set DATABASE_SSL=false only for a local PostgreSQL server without SSL.
DATABASE_SSL=true

ADMIN_USER=Sainik
ADMIN_PASSWORD=change-this-password
JWT_SECRET=change-this-long-random-secret

UPI_ID=your-upi-id@upi
UPI_NAME=Sainik Library

PAYMENT_AMOUNT=500
DAILY_AMOUNT=50
MONTHLY_AMOUNT=500
QUARTERLY_AMOUNT=1500
